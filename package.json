{
  "name": "hiken-seoul-culture",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build && node server/dev.ts",
    "start": "node server/dev.ts",
    "build": "npm run typecheck && npm test && node scripts/build.ts && node scripts/verify-build.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "preview:fixture": "npm run build && node scripts/preview-fixture.ts",
    "sync:data": "node scripts/sync-events.ts",
    "sync:translations": "node scripts/sync-translations.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
