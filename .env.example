# Default data source: Seoul's official HTTPS JSON export. No API key required.
# Optional local persistent cache directory (default: .cache/).
# HIKEN_CACHE_DIR=C:/path/to/private-cache
# PORT=4173
# Server only. Never prefix these with a public/client environment variable name.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# At least 32 random characters. Vercel sends this as the scheduled job bearer token.
CRON_SECRET=
